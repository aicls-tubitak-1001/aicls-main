# AI-CLS environment file (pydantic-settings, prefix AICLS_). Copy to `.env`; `.env` is git-ignored.
# Reference: docs/gelistirme/kurulum.md §2. Values below are the development defaults.

# ---- runtime profile ---------------------------------------------------------------------
# dev | test | prod
AICLS_ENV=dev
# full | collect (collect = voice data-collection VM: only auth/contribute/health routers)
AICLS_PROFILE=full

# ---- storage (MUST be outside OneDrive — ADR-0008 / ADR-0011; `poe env-check` verifies) ----
# Data root: datasets, audio recordings, runs, mlruns, SQLite dev DB. D: preferred, else C:\aicls-data.
AICLS_DATA_ROOT=D:\aicls-data
# Checkpoints and pre-trained weights (default: %AICLS_DATA_ROOT%\models)
AICLS_MODELS_ROOT=D:\aicls-data\models
# SQLAlchemy URL. Dev: SQLite under the data root. Prod: mysql+pymysql://aicls_app:***@127.0.0.1/aicls?charset=utf8mb4
AICLS_DB_URL=sqlite+pysqlite:///D:/aicls-data/aicls-dev.db

# ---- security -----------------------------------------------------------------------------
# REQUIRED, >= 32 bytes hex. Generate: python -c "import secrets; print(secrets.token_hex(32))"
AICLS_JWT_SECRET=
# JSON list of allowed browser origins
AICLS_CORS_ORIGINS=["http://localhost:5173"]
# Rate limiting (disabled in tests)
AICLS_RATE_LIMIT_ENABLED=true

# ---- models and fallbacks -----------------------------------------------------------------
# true -> load `model_versions.is_active` OCR/ASR models; false -> deterministic stubs
AICLS_MODELS_ENABLED=false
# Optional LLM intent suggester for the text->command layer (intent id only, never results)
AICLS_LLM_FALLBACK=false
AICLS_LLM_ENDPOINT=
AICLS_LLM_API_KEY=

# ---- voice data collection tab ("Model Gelişimine Katkıda Bulun") -------------------------
AICLS_CONTRIB_ENABLED=false
# Ethics committee decision reference; while empty the contribute endpoints answer 503
AICLS_ETHICS_APPROVAL_REF=

# ---- CAS sandbox --------------------------------------------------------------------------
# Seconds before a SymPy worker is killed (ADR-0016)
AICLS_COMPUTE_TIMEOUT_S=2.5
# Pre-warmed SymPy worker processes
AICLS_SANDBOX_WORKERS=2

# ---- logging ------------------------------------------------------------------------------
AICLS_LOG_LEVEL=INFO

# ---- APPROVAL GATES (ADR-0012) — leave EMPTY. -----------------------------------------------
# A gated action runs only when ALL three hold: CLI flag --i-have-approval,
# AICLS_GATE_<NAME>=approved, and an `approved` row in docs/gelistirme/onay-defteri.md.
# CI never sets these. Do not commit a `.env` with any of them set.
AICLS_GATE_DATASET_DOWNLOAD=
AICLS_GATE_WEIGHTS_DOWNLOAD=
AICLS_GATE_CUDA_INSTALL=
AICLS_GATE_TRAINING=

# ---- test-only switches -------------------------------------------------------------------
# mysql-marked tests run only when set, e.g. mysql+pymysql://root:root@127.0.0.1:3306/aicls_test
AICLS_TEST_MYSQL_URL=
# 1 -> run gpu-marked tests (workstation only, after gate 3)
AICLS_TEST_GPU=

# ---- Python (bytecode cache outside OneDrive) ---------------------------------------------
PYTHONPYCACHEPREFIX=C:\Users\cagri\.cache\ai-cls\pycache
PYTHONUTF8=1
