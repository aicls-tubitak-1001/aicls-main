# EditorConfig — https://editorconfig.org (ADR-0011: LF + UTF-8 everywhere)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
max_line_length = 100

[*.{toml,yaml,yml,json,jsonld,cff}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{ps1,psm1}]
end_of_line = lf

[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab
